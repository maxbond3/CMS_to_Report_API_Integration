        "language": "pythonNative",
        "pythonCode": "csv_lines = []\n\nfor item in _items:\n    row = item.get('json', {})\n    \n    # Order matches your database schema fields precisely\n    columns = [\n        row.get('spare_code'),\n        row.get('spare_name'),\n        row.get('spare_description'),\n        row.get('spare_type'),\n        row.get('spare_status'),\n        row.get('price'),\n        row.get('quantity'),\n        row.get('updated_at')\n    ]\n    \n    # Convert everything to string, converting None/null to an empty string ''\n    line = \";\".join(str(val) if val is not None else '' for val in columns)\n    csv_lines.append(line)\n\nraw_csv_text = \"\\n\".join(csv_lines)\n\nreturn [{\"json\": {\"csvData\": raw_csv_text}}]\n"
      },
